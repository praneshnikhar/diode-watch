{
  "name": "Diode Watch — Alert Routing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "diode-alert",
        "responseMode": "onReceived"
      },
      "id": "7a1b2c3d-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "webhookId": "3f2fa6fc-ab67-43a0-8636-aae990dcf068",
      "position": [-520, 0]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.severity }}",
              "operation": "equals",
              "value2": "HIGH"
            },
            {
              "value1": "={{ $json.body.severity }}",
              "operation": "equals",
              "value2": "CRITICAL"
            }
          ]
        },
        "combinator": "or"
      },
      "id": "7a1b2c3d-0002-4000-8000-000000000002",
      "name": "HIGH or CRITICAL?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-280, 0]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $env.SLACK_WEBHOOK }}",
              "operation": "notEmpty"
            }
          ]
        },
        "combinator": "and"
      },
      "id": "7a1b2c3d-0003-4000-8000-000000000003",
      "name": "Slack configured?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-40, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\": \"DIODE-WATCH [{{ $json.body.severity }}] {{ $json.body.threat_class }} — {{ $json.body.src_ip }} -> {{ $json.body.dst_ip }} (conf {{ $json.body.confidence }}). {{ $json.body.explanation }}\"}"
      },
      "id": "7a1b2c3d-0004-4000-8000-000000000004",
      "name": "Slack notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [200, 0]
    },
    {
      "parameters": {},
      "id": "7a1b2c3d-0005-4000-8000-000000000005",
      "name": "NoOp",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [460, 0]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          { "node": "HIGH or CRITICAL?", "type": "main", "index": 0 }
        ]
      ]
    },
    "HIGH or CRITICAL?": {
      "main": [
        [
          { "node": "Slack configured?", "type": "main", "index": 0 }
        ],
        [
          { "node": "NoOp", "type": "main", "index": 0 }
        ]
      ]
    },
    "Slack configured?": {
      "main": [
        [
          { "node": "Slack notify", "type": "main", "index": 0 }
        ],
        [
          { "node": "NoOp", "type": "main", "index": 0 }
        ]
      ]
    },
    "Slack notify": {
      "main": [
        [
          { "node": "NoOp", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
